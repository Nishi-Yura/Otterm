# otterm.danger-guard (English)

rule-iex-message = Runs downloaded content directly. Safer to inspect it first
rule-iex-alt-label = Inspect first

danger-alt-hint = If there is an alternative such as moving to the trash, use its button
danger-blocked = Blocked: { $message }
danger-warn = Caution: { $message }
danger-muted = This confirmation will not be shown again. Undo with "Danger guard: show all confirmations again"
danger-unmuted = All stopped confirmations are shown again
danger-nothing = No recent confirmation to mute

cmd-mute-last = Stop asking about the last confirmation
cmd-unmute-all = Danger guard: show all confirmations again
