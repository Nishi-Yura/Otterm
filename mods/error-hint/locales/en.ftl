# otterm.error-hint (English)

hint-missing = { $program } was not found. It is not installed, or not on PATH.
hint-install-one = To install: { $command }
hint-install-many = To install (package managers found): { $list }
hint-install-any = Ways to install: { $list }
hint-permission = Permission denied. Check the file owner or whether admin rights are needed. Read a script before using sudo
hint-no-path = Path not found. Check the name and location. ls shows the current folder
hint-not-repo = This is not a Git repository. Run git init to start one, or move to the repository folder
hint-port = Port { $port } is in use by another program. Use { $tool } to see which process holds it
hint-pip = The Python package { $module } is not installed. You can install it with pip
hint-npm = The npm package { $module } was not found. You can add it to this project
