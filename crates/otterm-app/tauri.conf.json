{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "otterm",
  "mainBinaryName": "otterm",
  "version": "0.0.0",
  "identifier": "dev.otterm.app",
  "build": {
    "frontendDist": "../../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @otterm/ui dev",
    "beforeBuildCommand": "pnpm --filter @otterm/ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "otterm",
        "width": 1000,
        "height": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src 'self' data: about:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
