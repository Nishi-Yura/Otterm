{
  "name": "create-otterm-mod",
  "version": "0.0.0",
  "description": "Scaffold a new otterm mod",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "create-otterm-mod": "./index.js"
  },
  "files": [
    "index.js",
    "templates",
    "!templates/extension/tsconfig.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p templates/extension"
  },
  "devDependencies": {
    "@otterm/api": "workspace:*"
  }
}
