# nishi-yura.bookmarks (English)

panel-title = Folder bookmarks
cmd-add = Bookmark this folder
cmd-open = Open folder bookmarks
hint = Click a folder to put a cd into the input line.
empty = No bookmarks yet. Press "Bookmark this folder" in a terminal.
menu-go = Go here (insert cd)
menu-open = Open in the file manager
menu-up = Move up
menu-down = Move down
menu-remove = Remove bookmark
toast-added = Bookmarked { $name }.
toast-exists = { $name } is already bookmarked.
toast-no-folder = No terminal is focused, so there is no folder to bookmark.
toast-full = You already have { $max } bookmarks. Remove one first.
