[
  {
    "id": "ja-001",
    "lang": "ja",
    "prompt": "このフォルダの中身を一覧で表示して",
    "expect": { "pwsh": ["Get-ChildItem", "ls", "dir", "gci"], "bash": ["ls", "ls -la", "ls -l", "ls -al"] },
    "match": "exact",
    "dangerous": false
  },
  {
    "id": "ja-002",
    "lang": "ja",
    "prompt": "work という名前の新しいフォルダを作って",
    "expect": {
      "pwsh": ["New-Item -ItemType Directory -Name work", "mkdir work", "New-Item work -ItemType Directory"],
      "bash": ["mkdir work", "mkdir -p work"]
    },
    "match": "exact",
    "dangerous": false
  },
  {
